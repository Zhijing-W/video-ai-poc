# Microsoft Foundry / Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://videopoc-foundry-tzj.openai.azure.com/
# auto: API key when explicitly supplied, otherwise DefaultAzureCredential/VM managed identity.
AZURE_OPENAI_AUTH=auto
# AZURE_OPENAI_API_KEY=<local-development-only-key>
AZURE_OPENAI_DEPLOYMENT=event-analysis-gpt41
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Recommended in hosted environments. Deployment discovery calls ARM using
# DefaultAzureCredential/managed identity; no key is sent to the browser.
# AZURE_OPENAI_RESOURCE_ID=/subscriptions/<subscription>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<foundry-account>
FOUNDRY_ANALYSIS_DEPLOYMENT=event-analysis-gpt41
FOUNDRY_CHAT_DEPLOYMENT=event-chat-gpt41-mini
FOUNDRY_ANALYSIS_MODEL=gpt-4.1
FOUNDRY_CHAT_MODEL=gpt-4.1-mini
EVENT_ANALYSIS_MODEL=auto
EVENT_CHAT_MODEL=auto

# Repository-local runtime directories
DATA_DIR=data
OUTPUT_DIR=out
GALLERY_DIR=gallery
# Leave empty to use ~/.cache/event-monitor/models. This directory is shared
# by normal checkouts, Copilot worktrees, product runs, and experiments.
MODEL_ROOT=

# Detection and tracking
# Optional per-model overrides; normally MODEL_ROOT supplies these paths.
# YOLO_MODEL=C:\model-storage\detection\yolo\yolov8m.pt
# POSE_MODEL=C:\model-storage\detection\yolo\yolov8n-pose.pt
# GAIT_SEG_MODEL=C:\model-storage\detection\yolo\yolov8m-seg.pt
YOLO_CONF=0.4
TRACK_BACKEND=botsort
TRACK_REID_BACKEND=osnet
TRACK_BUFFER_SECONDS=1.0
EVENT_TRACKING_FPS=15
EVENT_TRACKING_MAX_FRAMES=1800
TRACK_ENROLL_MIN_SECONDS=0.5
TRACK_ENROLL_MIN_OBSERVATIONS=2
GAIT_SAMPLE_FPS=10
# Accuracy-first product default under the current frozen protocol.
REID_BACKEND=differ
# REID_OSNET_WEIGHTS=C:\model-storage\reid\osnet\osnet_ain_x1_0_msmt17.pt
# REID_RESNET50_WEIGHTS=C:\model-storage\reid\resnet50\resnet50-11ad3fa6.pth
# REID_CLIPREID_ROOT=C:\model-storage\reid\clipreid\source
# REID_CLIPREID_CONFIG=C:\model-storage\reid\clipreid\source\configs\person\vit_clipreid.yml
# REID_CLIPREID_WEIGHTS=C:\model-storage\reid\clipreid\ViT-B-16_msmt17_60.pth
# REID_CLIPREID_BASE_WEIGHTS=C:\model-storage\reid\clipreid\ViT-B-16.pt
# REID_SIGLIP2_MODEL=C:\model-storage\reid\siglip2\model
# REID_DIFFER_ROOT=C:\model-storage\reid\differ\source
# REID_DIFFER_CONFIG=C:\model-storage\reid\differ\config.yml
# REID_DIFFER_WEIGHTS=C:\model-storage\reid\differ\eva02_l_bio_best.pth

# Optional face providers
FACE_DEVICE=auto
FACE_MODEL=buffalo_l
FACE_REC_BACKEND=arcface
# FACE_INSIGHTFACE_ROOT=C:\model-storage\face\insightface
# FACE_ADAFACE_ROOT=C:\model-storage\face\adaface\source
# FACE_ADAFACE_WEIGHTS=C:\model-storage\face\adaface\model.pt
FACE_FIQA_BACKEND=cr_fiqa
# FACE_FIQA_ROOT=C:\model-storage\face\cr_fiqa\source
# FACE_FIQA_WEIGHTS=C:\model-storage\face\cr_fiqa\32572backbone.pth
FACE_FIQA_ARCH=iresnet50
FACE_FIQA_DEVICE=auto
# CR-FIQA仅输出诊断，不改变分桶、路由或恢复后验收；阈值不是通用概率。
FACE_FIQA_POOR_THRESH=0.3
FACE_FIQA_CLEAR_THRESH=0.6
# off 或已注册的超分后端名称；内置 gfpgan/codeformer/realesrgan_x2plus
FACE_SUPERRES=off
FACE_RECOVERABLE_MIN_SIZE=20
FACE_SUPERRES_MAX_SIZE=90
FACE_CANDIDATE_TOP_K=3
FACE_CANDIDATE_MIN_GAP_SECONDS=0.5
FACE_TRACK_CONSISTENCY_THRESH=0.82
# FACE_GFPGAN_WEIGHTS=C:\model-storage\superres\gfpgan\GFPGANv1.3.pth
# FACE_CODEFORMER_WEIGHTS=C:\model-storage\superres\codeformer\codeformer-v0.1.0.pth
# [0,1]；1.0 优先保持身份，较低值更偏向视觉修复。
FACE_CODEFORMER_FIDELITY=1.0
# FACE_REALESRGAN_X2PLUS_WEIGHTS=C:\model-storage\superres\realesrgan\RealESRGAN_x2plus-v0.2.1.pth

# Optional gait provider
GAIT_ENABLED=true
GAIT_DEVICE=cpu
# GAIT_OPENGAIT_ROOT=C:\model-storage\gait\opengait\source
# GAIT_CKPT=C:\model-storage\gait\opengait\SkeletonGaitPP-180000.pt

# Optional scene providers
OCR_ENABLED=false
OBJECT_DETECT=false

# Event analysis
EVENT_LLM_DEPLOYMENT=
EVENT_WINDOW_MAX_SECONDS=30
EVENT_OVERALL_SUMMARY=1
EVENT_CHAT_MAX_TOKENS=900
EVENT_CHAT_HISTORY_TURNS=6
# Hard limits for compact TSV evidence injected into event and chat prompts.
EVENT_EVIDENCE_MAX_CHARS=48000
EVENT_EVIDENCE_TABLE_MAX_ROWS=120
EVENT_EVIDENCE_TABLE_MAX_CHARS=6000

# ffmpeg executable; leave empty to use PATH
FFMPEG_PATH=
