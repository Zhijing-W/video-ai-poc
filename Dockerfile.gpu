# Lightweight application layer built on the currently validated GPU image.
# The build supplies GPU_BASE_IMAGE so CUDA and model dependencies are reused.
ARG GPU_BASE_IMAGE
FROM ${GPU_BASE_IMAGE}

USER root
WORKDIR /app

# Prevent removed source files from surviving when the base came from an older app.
RUN rm -rf /app/app /app/templates /app/static /app/experiment /app/licenses

COPY --chown=appuser:appuser app        ./app
COPY --chown=appuser:appuser templates  ./templates
COPY --chown=appuser:appuser static     ./static
COPY --chown=appuser:appuser experiment ./experiment
COPY --chown=appuser:appuser licenses   ./licenses

USER appuser

ENV MODEL_ROOT=/models \
    OUTPUT_DIR=/results \
    YOLO_MODEL=/models/detection/yolo/yolov8m.pt \
    POSE_MODEL=/models/detection/yolo/yolov8n-pose.pt \
    GAIT_SEG_MODEL=/models/detection/yolo/yolov8m-seg.pt \
    REID_BACKEND=differ \
    REID_BACKEND=differ

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD curl -fsS http://localhost:${PORT}/health > /dev/null || exit 1

CMD ["sh", "-c", "gunicorn app.main:app -k uvicorn.workers.UvicornWorker -b 0.0.0.0:${PORT} --workers 1 --timeout 300"]
