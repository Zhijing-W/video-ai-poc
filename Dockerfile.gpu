# Lightweight application layer. The workflow supplies a dependency image whose
# tag is derived from Dockerfile.gpu.base and requirements.txt.
ARG GPU_BASE_IMAGE
FROM ${GPU_BASE_IMAGE}

USER root
WORKDIR /app

# Delete source inherited when the dependency image was bootstrapped from an
# existing application image, so removed files cannot survive a deployment.
RUN rm -rf /app/app /app/templates /app/static /app/experiment /app/licenses

COPY --chown=appuser:appuser app        ./app
COPY --chown=appuser:appuser templates  ./templates
COPY --chown=appuser:appuser static     ./static
COPY --chown=appuser:appuser experiment ./experiment
COPY --chown=appuser:appuser licenses   ./licenses

USER appuser

ENV MODEL_ROOT=/models \
    REID_BACKEND=differ

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD curl -fsS http://localhost:${PORT}/docs > /dev/null || exit 1

CMD ["sh", "-c", "gunicorn app.main:app -k uvicorn.workers.UvicornWorker -b 0.0.0.0:${PORT} --workers 1 --timeout 300"]
